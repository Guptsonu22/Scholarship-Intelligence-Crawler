# Environment Configuration for Scholarship Intelligence Crawler

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Database
# Use relative path or absolute path. Default stores SQLite database under data/scholarships.db
DATABASE_URL=sqlite:///./data/scholarships.db

# Crawler Configuration
CRAWLER_USER_AGENT=ScholarshipIntelligenceCrawler/1.0 (+https://github.com/scholarship-intelligence-crawler; respectful-bot)
CRAWLER_REQUEST_TIMEOUT=15
CRAWLER_DEFAULT_DELAY_SECONDS=2.0
CRAWLER_MAX_RETRIES=3

# Scheduler
ENABLE_SCHEDULER=False
SCHEDULER_INTERVAL_HOURS=24
